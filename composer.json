{
  "name": "abyssforge/sdk-php",
  "description": "AbyssForge PHP SDK with generated API bindings and ergonomic auth helpers",
  "type": "library",
  "license": "Unlicense",
  "require": {
    "php": "^8.1",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "guzzlehttp/guzzle": "^7.3",
    "guzzlehttp/psr7": "^1.7 || ^2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.0"
  },
  "autoload": {
    "psr-4": {
      "AbyssForge\\": "generated/src/",
      "AbyssForgeSdk\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AbyssForgeSdk\\Tests\\": "tests/"
    }
  }
}
